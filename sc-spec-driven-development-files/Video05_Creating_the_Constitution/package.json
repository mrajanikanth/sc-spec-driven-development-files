{
  "name": "agentclinic",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n css,server -c magenta,cyan \"tailwindcss -i ./src/styles/input.css -o ./public/styles.css --watch\" \"tsx watch src/index.ts\"",
    "build": "tailwindcss -i ./src/styles/input.css -o ./public/styles.css --minify && tsc",
    "start": "node dist/index.js",
    "css": "tailwindcss -i ./src/styles/input.css -o ./public/styles.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/input.css -o ./public/styles.css --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.8"
  },
  "private": true
}
