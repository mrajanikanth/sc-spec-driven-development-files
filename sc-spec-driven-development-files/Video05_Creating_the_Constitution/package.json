{
  "name": "agentclinic",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "css": "node -e \"require('fs').copyFileSync('node_modules/@picocss/pico/css/pico.min.css', 'public/pico.min.css')\"",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/run-seed.ts",
    "dev": "pnpm css && tsx watch src/index.ts",
    "build": "pnpm css && tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@picocss/pico": "^2.0.6",
    "better-sqlite3": "^12.10.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.8"
  },
  "private": true
}
